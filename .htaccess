# .htaccess - CORRECTED VERSION

# Enable rewrite engine
RewriteEngine On

# Security headers - Apache syntax
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "DENY"
Header set X-XSS-Protection "1; mode=block"
Header set Referrer-Policy "strict-origin-when-cross-origin"

# Handle Telegram webhook
RewriteCond %{REQUEST_METHOD} POST
RewriteRule ^(.*)$ index.php [QSA,L]

# Allow access to files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Disable directory listing
Options -Indexes

# Protect sensitive files (Apache 2.4 syntax)
<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env|\.htaccess|movies\.csv|users\.json|bot_stats\.json|movie_requests\.json|bot_activity\.log)$">
        Require all denied
    </FilesMatch>
    
    # Allow access to index.php and public files
    <Files "index.php">
        Require all granted
    </Files>
    <Files "movies.csv">
        Require all granted
    </Files>
    <Files "*.json">
        Require all granted
    </Files>
</IfModule>

# For Apache 2.2 compatibility
<IfModule !mod_authz_core.c>
    <FilesMatch "^(\.env|\.htaccess|movies\.csv|users\.json|bot_stats\.json|movie_requests\.json|bot_activity\.log)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
    
    # Allow access to index.php and public files
    <Files "index.php">
        Order Allow,Deny
        Allow from all
    </Files>
    <Files "movies.csv">
        Order Allow,Deny
        Allow from all
    </Files>
    <Files "*.json">
        Order Allow,Deny
        Allow from all
    </Files>
</IfModule>

# Set default charset
AddDefaultCharset UTF-8

# Prevent access to hidden files
RedirectMatch 404 /\.git
RedirectMatch 404 /\.env
RedirectMatch 404 /\.htaccess

# Set PHP variables via .htaccess (if needed)
# php_value upload_max_filesize 100M
# php_value post_max_size 100M
# php_value memory_limit 256M
# php_value max_execution_time 300
