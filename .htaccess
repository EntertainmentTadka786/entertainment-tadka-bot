# .env
# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_admin_id_here

# Render.com Specific
PORT=8080
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com

# Bot Settings
MAINTENANCE_MODE=false
DAILY_REQUEST_LIMIT=5
CACHE_EXPIRY=300

