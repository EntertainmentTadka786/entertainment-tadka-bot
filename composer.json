{
    "name": "entertainment-tadka/telegram-bot",
    "description": "Entertainment Tadka Telegram Bot - Movie Search & Delivery System",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Entertainment Tadka",
            "email": "entertainmenttadka@proton.me"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "files": ["bot.php"]
    },
    "scripts": {
        "test": "phpunit tests/",
        "start": "php -S 0.0.0.0:8080 bot.php",
        "deploy": "php bot.php --deploy",
        "backup": "php bot.php --backup",
        "clean": "php bot.php --clean"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}